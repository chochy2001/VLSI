LIBRARY IEEE;
USE IEEE.STD_LOGIC_1164.ALL;
USE IEEE.NUMERIC_STD.ALL;

ENTITY separa IS
PORT(
    CUENT: IN UNSIGNED(7 DOWNTO 0);
    C, D, U: OUT UNSIGNED(3 DOWNTO 0)
);
END ENTITY;

ARCHITECTURE BEAS OF separa IS
BEGIN
    C <= UNSIGNED(CUENT(7 DOWNTO 4));
    D <= UNSIGNED(CUENT(3 DOWNTO 0));
    U <= UNSIGNED(CUENT(3 DOWNTO 0));
END BEAS;