LIBRARY IEEE;
USE IEEE.STD_LOGIC_1164.ALL;

ENTITY deco IS
	PORT(LETRA: IN INTEGER RANGE 0 TO 255;
	       SEG: OUT STD_LOGIC_VECTOR(7 DOWNTO 0));
END deco;

ARCHITECTURE BEAS OF deco IS
BEGIN
	
	WITH LETRA SELECT
		SEG <= "00010001" WHEN 0, -- A
"10000101" WHEN 1, -- b
"10000101" WHEN 2, -- d
"01000001" WHEN 3, -- G
"10011111" WHEN 4, -- I
"00010011" WHEN 5, -- n
"11000100" WHEN 6, -- o
"11110101" WHEN 7, -- r
"00001001" when 8,---9
"11111111" when 9,--
"11111111" WHEN OTHERS;		 
	
END BEAS;