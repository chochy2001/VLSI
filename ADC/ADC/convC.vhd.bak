LIBRARY IEEE;
USE IEEE.STD_LOGIC_1164.ALL;
USE IEEE.NUMERIC_STD.ALL;

ENTITY convC IS
    PORT(
        CUENTAS: IN STD_LOGIC_VECTOR (11 DOWNTO 0);
        M,C,D,U: OUT INTEGER RANGE 0 TO 9
    );
END ENTITY conv;

ARCHITECTURE Behavioral OF conv IS
    SIGNAL Vm_scaled : INTEGER RANGE 0 TO 5000; -- 5000 es el máximo valor posible según la fórmula
BEGIN
    -- Proceso para calcular Vm_scaled
    PROCESS (CUENTAS)
    BEGIN
        Vm_scaled <= TO_INTEGER(unsigned(CUENTAS)) * 5000 / 4095;
    END PROCESS;

    -- Decodificación de Vm_scaled para obtener unidades, decenas, centenas y millares
    U <= Vm_scaled mod 10;
    D <= (Vm_scaled / 10) mod 10;
    C <= (Vm_scaled / 100) mod 10;
    M <= (Vm_scaled / 1000) mod 10;

END ARCHITECTURE Behavioral;
